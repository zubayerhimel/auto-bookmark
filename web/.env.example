# ---------- Clerk (sign-in) ----------
# Clerk dashboard > API keys, or `pnpm dlx clerk@latest env pull`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Database (Supabase Postgres) ----------
# Local: `pnpm supabase start` (defaults below).
# Hosted: Supabase dashboard > Connect. The app uses the "Transaction pooler" string (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Used only by `pnpm db:migrate`. Hosted: the "Session pooler" string (port 5432). Leave empty locally.
DIRECT_URL=

# ---------- AI ----------
# OpenRouter (default): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: "openrouter" (default), "openai" (OPENAI_API_KEY) or "google" (GOOGLE_GENERATIVE_AI_API_KEY)
# AI_PROVIDER=openrouter

# Optional model overrides (OpenRouter model ids). The embedding model must return 1536 dimensions.
# AI_MODEL=openai/gpt-5.4-mini
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small
