# ---------- Supabase ----------
# Local: values printed by `pnpm supabase start` (shown below).
# Hosted: Supabase dashboard > Connect (or Project Settings > API Keys / Database).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Postgres used by the server. Hosted on Vercel: the "Transaction pooler" string (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Used only by `pnpm db:migrate`. Hosted: the "Session pooler" or direct string (port 5432).
# Leave empty locally.
DIRECT_URL=

# Google sign-in for the LOCAL Supabase stack only (hosted projects set this in the dashboard).
# Redirect URI to register in Google Cloud: http://127.0.0.1:54321/auth/v1/callback
# These are read by `pnpm supabase start`, so export them in your shell or put them in supabase/.env.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------- AI ----------
# OpenRouter (default): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: "openrouter" (default), "openai" (OPENAI_API_KEY) or "google" (GOOGLE_GENERATIVE_AI_API_KEY)
# AI_PROVIDER=openrouter

# Optional model overrides (OpenRouter model ids). The embedding model must return 1536 dimensions.
# AI_MODEL=openai/gpt-5.4-mini
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small
