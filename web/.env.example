# ---------- Clerk (sign-in) ----------
# Clerk dashboard > API keys, or `pnpm dlx clerk@latest env pull`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Database (Supabase Postgres) ----------
# Local: `pnpm supabase start` (defaults below).
# Hosted: Supabase dashboard > Connect. The app uses the "Transaction pooler" string (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Used only by `pnpm db:migrate`. Hosted: the "Session pooler" string (port 5432). Leave empty locally.
DIRECT_URL=

# ---------- AI ----------
# Each user adds their own AI key in the app (AI settings). This secret encrypts those keys.
# Any long random string, e.g. `openssl rand -hex 32`. Changing it makes saved keys unreadable.
AI_KEY_SECRET=

# Optional, for private self-hosting: let users without their own key use the server's key.
# Off by default so a public deployment never spends your credits.
# AI_USE_SERVER_KEY=true
# OPENROUTER_API_KEY=
# "openrouter" (default), "openai" (OPENAI_API_KEY), "google" (GOOGLE_GENERATIVE_AI_API_KEY),
# "groq" (GROQ_API_KEY) or "anthropic" (ANTHROPIC_API_KEY)
# AI_PROVIDER=openrouter

# Optional model overrides for the server key. The embedding model must return 1536 dimensions.
# AI_MODEL=openai/gpt-5.4-mini
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------- Daily job ----------
# Protects /api/cron (dead-link checks). Vercel sends it automatically when it runs the cron.
# Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
