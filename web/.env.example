# Postgres with the pgvector extension (docker compose up -d starts one on port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/auto_bookmark

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider: "openai" or "google"
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides
# AI_MODEL=gpt-5.4-mini            (google default: gemini-3.5-flash)
# AI_EMBEDDING_MODEL=text-embedding-3-small   (google default: gemini-embedding-001)
